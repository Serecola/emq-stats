# Admin panel login (single shared password — no user accounts).
# The one credential compared at the login door. Make it long and random.
ADMIN_PASSWORD=
# REQUIRED. The session cookie's value is SHA-256(secret + ':' + the current
# 90-day window), so the secret never appears in a cookie and every 90 days all
# sessions expire and the admin signs back in with the same password. Any long
# random string works (`openssl rand -base64 32`); changing it and rebuilding +
# restarting the server expires every session immediately. Without it the admin
# area denies access — it is never derived from the password.
ADMIN_SESSION_SECRET=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
